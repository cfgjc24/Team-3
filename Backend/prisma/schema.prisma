datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Provider {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  phone           String
  bio             String?
  availability    String
  location        String?
  cases           Case[]   
  adminId         Int       // Foreign key to link to the Admin model
  admin           Admin     @relation(fields: [adminId], references: [id]) // Establish the relationship with Admin
  sessionNotes    SessionNote[] // Relationship to the SessionNote model
}

model Admin {
  id               Int         @id @default(autoincrement())
  name             String
  email            String      @unique
  password         String
  phone            String
  providers        Provider[]  // Relationship to the Provider model
}

model Case {
  id             Int       @id @default(autoincrement())
  title          String    // Title or short description of the case
  description    String?   // Detailed description of the case
  status         CaseStatus // Status of the case (e.g., OPEN, CLOSED, PENDING)
  startDate      DateTime  // When the case started
  endDate        DateTime? // When the case ended (optional)
  providerId     Int       // Foreign key to link to the Provider model
  provider       Provider  @relation(fields: [providerId], references: [id])
  sessionNotes   SessionNote[] // Relationship to the SessionNote model
  @@map("cases")
}

enum CaseStatus {
  OPEN
  CLOSED
  PENDING
}

model SessionNote {
  id                Int        @id @default(autoincrement())
  providerId       Int        // Foreign key linking to the Provider model
  provider         Provider   @relation(fields: [providerId], references: [id])
  caseId           Int?       // Optional foreign key linking to a Case model
  case             Case?      @relation(fields: [caseId], references: [id])
  serviceDate      DateTime   // Date and time of the session
  appointmentId    String?    // Identifier for the appointment (if applicable)
  serviceType      String     // Type of service provided (e.g., "ENHANCED PSR")
  sessionFocus     String     // Focus of the session, including goals and objectives
  therapeuticIntervention String // Interventions, activities, and client's response
  plannedIntervention    String  // Progress made and plan for the future
}